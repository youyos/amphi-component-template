{
  "name": "@local/amphi-custom-components",
  "version": "0.1.0",
  "description": "Reusable built-in component extension template for Amphi",
  "license": "UNLICENSED",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/*.d.ts"
  ],
  "scripts": {
    "build": "jlpm run validate:python && jlpm run build:lib && jlpm run build:labextension",
    "build:lib": "tsc --build",
    "build:labextension": "jupyter labextension build --development True .",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo",
    "validate:python": "python scripts/validate_embedded_python.py"
  },
  "dependencies": {
    "@amphi/pipeline-components-manager": "*",
    "@jupyterlab/application": "4.4.10"
  },
  "devDependencies": {
    "@jupyterlab/builder": "4.4.10",
    "rimraf": "5.0.10",
    "typescript": "5.8.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "sharedPackages": {
      "@amphi/pipeline-components-manager": {
        "bundled": false,
        "singleton": true,
        "strictVersion": false
      }
    }
  }
}
